# Copy to .env locally. Vite only exposes vars prefixed with VITE_.

# --- Local dev (default) ---
# Vite proxies /api to the backend (see vite.config.ts). Leave unset to use relative /api.
# VITE_API_BASE_URL=
# VITE_WS_URL=

# --- Production (SPA on one host, API on another) ---
# REST: must include the /api path prefix used by the backend mount.
# VITE_API_BASE_URL=https://api.yourdomain.com/api
# Socket.io HTTP origin only (no /api path). Usually same host as API without path.
# VITE_WS_URL=https://api.yourdomain.com

# --- Staff portal ---
# If the admin/agent app is served from the same origin as the public site, you can force staff routes:
# VITE_FORCE_STAFF_PORTAL=true
# Link back to the public marketing site from staff login, etc.:
# VITE_MAIN_SITE_URL=https://www.yourdomain.com
