# Core
NODE_ENV=development
PORT=5000
REQUEST_TIMEOUT=30000
# Local or MongoDB Atlas, e.g. mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/rsfgaming
MONGODB_URI=mongodb://localhost:27017/rsfgaming

# URLs (comma-separate every browser origin that calls this API, e.g.
# https://www.yourdomain.com,https://super.yourdomain.com)
# In development, super.localhost is auto-allowed when localhost is listed.
FRONTEND_URL=http://localhost:5173
PRODUCTION_FRONTEND_URL=https://yourdomain.com
# Public base URL of this API (absolute links, webhooks). Match your deploy hostname.
BACKEND_URL=http://localhost:5000
#
# Frontend build: set VITE_API_BASE_URL and VITE_WS_URL in frontend/.env — see frontend/.env.example.
# WebSocket chat: reverse proxy must allow Upgrade; VITE_WS_URL should match the Socket.io server origin.
ALLOW_LOCALHOST_IN_PROD=false
ALLOW_NO_ORIGIN=false
ALLOW_VERCEL_PREVIEWS=false

# Authentication
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# Dev only: log verification codes / reset URLs instead of sending email (no Brevo key needed)
# SKIP_EMAIL=true
JWT_REFRESH_EXPIRES_IN=30d
AGENT_JWT_SECRET=your-agent-jwt-secret-here

# Default Super Admin (created on first startup)
AGENT_USERNAME=admin
AGENT_PASSWORD=admin123

# Brevo (Email) — create API key at https://app.brevo.com/settings/keys/cpa (enable "Send emails")
# BREVO_FROM_EMAIL must be a verified sender in Brevo: Senders & IP → your domain or a single address
# If mail never arrives: watch server logs for "Brevo SMTP API error" (unverified sender is the usual cause)
# Remove SKIP_EMAIL or set SKIP_EMAIL=false to actually send (when key + sender are set)
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=YourSiteName
# Optional; leave blank if unused
BREVO_REPLY_TO=

# Cloudinary (Image Uploads) — use either the dashboard URL or the three vars (not both required if URL is set)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@cloud_name
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Integration ping GET /api/health/integrations — enabled automatically when NODE_ENV is not production.
# Force on: ALLOW_INTEGRATION_HEALTH=true  |  Force off: ALLOW_INTEGRATION_HEALTH=false

# NOWPayments (Crypto)
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-ipn-secret

# OneSignal (Push Notifications)
ONESIGNAL_APP_ID=your-app-id
ONESIGNAL_REST_API_KEY=your-rest-api-key
